{% extends 'base.html.twig' %}

{% block contentBody %}
    <h2>Showing {{ hits|length }} results for "{{ query }}"</h2>

    <ul>
        {% for hit in hits %}
            <li>
                <a href="{{ hit.url }}">
                    {{- hit.title|raw -}}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

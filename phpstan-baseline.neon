		-
			message: '#^Instanceof between Symfony\\Component\\DependencyInjection\\ContainerInterface and Symfony\\Component\\DependencyInjection\\ContainerInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Build/UserBuilder.php

		-
			message: '#^Cannot access offset ''id'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible

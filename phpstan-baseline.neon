			identifier: argument.type
			count: 1
			path: src/Content/PropertyResolver/SingleAlbumSelectionPropertyResolver.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertArrayHasKey\(\) with ''id'' and array\{id\: int\|null, title\: string, image\: array\{id\: int\}\|null, tracklist\: array\<mixed\>\} will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 2
